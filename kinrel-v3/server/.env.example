# Daxelo-Kinrel server — environment template
# Copy to .env and adjust as needed.

# PostgreSQL connection string. The kinship_vocabulary table is ~5MB.
# Example for local dev:
DATABASE_URL="postgresql://daxelo:daxelo@localhost:5432/daxelo_kinrel?schema=public"

# Optional: cache settings (spec §13)
KINSHIP_CACHE_MAX_PER_FAMILY=1000
KINSHIP_ADJACENCY_CACHE_TTL_MS=60000
