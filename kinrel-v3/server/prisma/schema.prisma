// Daxelo-Kinrel Deterministic Kinship Engine v3.1
// Prisma schema — fundamental-edge storage + vocabulary mapper
// Spec reference: §2 (4 edge types), §6 (KinshipSignature), §7 (Vocabulary Mapper)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PERSON — a node in the family graph
// ============================================================================
model Person {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fullName    String
  gender      Gender   // male | female | other — drives gender-specific terms
  birthDate   DateTime?
  deathDate   DateTime? // null = living; non-null = deceased (drives temporal="late")
  isAdopted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Fundamental-edge endpoints (only 4 types — see spec §2)
  parentEdgesAsChild     Relationship[] @relation("child_edges")
  parentEdgesAsParent    Relationship[] @relation("parent_edges")
  spouseEdges            Relationship[] @relation("spouse_a_edges")
  spouseEdgesReverse     Relationship[] @relation("spouse_b_edges")

  @@index([familyId])
  @@index([familyId, gender])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ============================================================================
// FAMILY — top-level container
// ============================================================================
model Family {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  persons     Person[]
  relationships Relationship[]
}

// ============================================================================
// RELATIONSHIP — fundamental edges ONLY (spec §2)
// ============================================================================
// Four canonical edge types. No derived rows (no uncle, cousin, etc.).
model Relationship {
  id          String          @id @default(cuid())
  familyId    String
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // The two endpoints. Direction depends on edgeType:
  //   parent         : personA (child) → personB (parent)
  //   spouse         : personA ↔ personB (bidirectional)
  //   adoptive_parent: personA (child) → personB (adoptive parent)
  //   step_parent    : personA (child) → personB (step-parent)
  personAId   String
  personA     Person          @relation("child_edges",    fields: [personAId], references: [id], onDelete: Cascade)
  personBId   String
  personB     Person          @relation("parent_edges",   fields: [personBId], references: [id], onDelete: Cascade)

  spouseAId   String?
  spouseA     Person?         @relation("spouse_a_edges", fields: [spouseAId], references: [id], onDelete: Cascade)
  spouseBId   String?
  spouseB     Person?         @relation("spouse_b_edges", fields: [spouseBId], references: [id], onDelete: Cascade)

  edgeType    EdgeType
  temporal    EdgeTemporal    @default(CURRENT)   // CURRENT | FORMER | LATE  (spec §6 temporal)
  isInferred  Boolean         @default(false)     // spec §9 spouse inference
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([familyId, personAId, personBId, edgeType, temporal], name: "no_duplicate_fundamental_edge")
  @@index([familyId, personAId, edgeType])
  @@index([familyId, personBId, edgeType])
  @@index([familyId, edgeType])
}

enum EdgeType {
  PARENT           // spec §2 — A → B means A's parent is B
  SPOUSE           // spec §2 — bidirectional
  ADOPTIVE_PARENT  // spec §2 — A → B means A's adoptive parent is B
  STEP_PARENT      // spec §2 — A → B means A's step-parent is B
}

enum EdgeTemporal {
  CURRENT  // active relationship
  FORMER   // divorced / severed — spec §6 temporal="former"
  LATE     // deceased partner (still considered a relationship in the tree)
}

// ============================================================================
// KINSHIP_VOCABULARY — 9,552 rows, runtime lookup table (spec §7)
// ============================================================================
// Deterministic lookup: WHERE signature_key = $1 AND language_code = $2 AND variant_rank = 0
model KinshipVocabulary {
  id                Int       @id @default(autoincrement())
  rowId             Int       @unique
  canonicalId       String    // PARENT | SPOUSE | ADOPTIVE_PARENT | STEP_PARENT | DERIVED
  signatureKey      String    // composite deterministic lookup key
  pathPattern       String    // traversal primitives, e.g. "UP_PARENT_UP_PARENT"
  generationDelta   Int       // -8..+8
  side              String    // paternal | maternal | none
  consanguinity     String    // blood | half | step | adoptive | inLaw | foster | spiritual
  genderAnchor      String    // male | female | neutral
  seniority         String    // elder | younger | twin | none
  removal           Int       // 0..8
  doubleKinship     Boolean
  temporal          String    @default("current") // current | former | late (NEW v3.1)
  category          String
  englishTerm       String
  notes             String?
  languageCode      String    // ISO 639-1
  languageName      String
  localizedTerm     String
  variantType       String    @default("primary") // primary | regional | dialectal
  variantRank       Int       @default(0)

  @@unique([signatureKey, languageCode, variantRank], name: "deterministic_lookup_idx")
  @@index([signatureKey, languageCode, variantRank])
  @@index([languageCode, category])
  @@index([canonicalId])
}
