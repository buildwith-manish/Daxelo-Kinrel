  // ── Relations ──
  family       Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User    @relation("QuestUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetPerson Person? @relation("QuestTargetPerson", fields: [targetPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetUser   User?   @relation("QuestTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([familyId, weekOf])
  @@index([userId, weekOf])
  @@index([status])
}

/// Silent alarm sent privately to the family bridge when someone goes quiet.
/// ONLY the bridge + family admins can see these (RLS enforced).
model SilentAlarm {
  id               String  @id @default(cuid())
  familyId         String
  inactivePersonId String
  inactiveUserId   String?
  bridgeUserId     String

  // ── Alarm details ──
  daysInactive Int       @default(0)
  lastActiveAt DateTime? @db.Timestamptz
  severity     String    @default("gentle") // gentle | moderate | urgent
  alarmMessage String

  // ── Lifecycle ──
  status           String    @default("triggered") // triggered | acknowledged | resolved | escalated
  acknowledgedAt   DateTime? @db.Timestamptz
  acknowledgedById String?
  resolvedAt       DateTime? @db.Timestamptz
  escalatedAt      DateTime? @db.Timestamptz

  // ── Suggestions for the bridge ──
  suggestions Json @default("[]")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family         Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inactivePerson Person @relation("AlarmInactivePerson", fields: [inactivePersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inactiveUser   User?  @relation("AlarmInactiveUser", fields: [inactiveUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bridgeUser     User   @relation("AlarmBridgeUser", fields: [bridgeUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  acknowledgedBy User?  @relation("AlarmAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([familyId])
  @@index([inactivePersonId])
  @@index([bridgeUserId])
  @@index([status])
}

/// AI-written family history book, monthly auto-update.
/// One row per family. Chapters stored as JSONB array.
model FamilyChronicle {
  id       String @id @default(cuid())
  familyId String @unique

  // ── Chronicle metadata ──
  title    String
  subtitle String?

  // ── Chapters (JSONB array) ──
  chapters Json @default("[]")

  // ── Current generation state ──
  chapterCount     Int       @default(0)
  lastGeneratedAt  DateTime? @db.Timestamptz
  nextGenerationAt DateTime? @db.Timestamptz

  // ── AI processing ──
  aiModel           String?
  aiProcessingError String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
