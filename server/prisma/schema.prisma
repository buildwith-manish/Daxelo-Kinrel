// ═══════════════════════════════════════════════════════════════════════════
// AURA — Ancestral Unified Relationship Archetype
// ═══════════════════════════════════════════════════════════════════════════
// Three tables that store the computed AURA parameters for each family.
// Migration: supabase/migrations/20260708010000_create_aura_tables.sql
//
// Computation flow:
//   Family graph changes (Person / Relationship CRUD)
//     → AuraEventListener debounces 2s
//     → AuraOrchestrationService.computeAndSave(familyId)
//       → GraphAnalysisService.computeMetrics()  (Brandes, BFS, clustering, …)
//       → ArchetypeClassifierService.classify()  (6 archetypes)
//       → AuraParameterGeneratorService.generate() (geometry + colors + pulse)
//       → upsert FamilyAura + push FamilyAuraHistory snapshot
//       → RoleGlyphService.computeAndSaveRoles() → upsert MemberAuraRole rows
//     → Supabase Realtime broadcasts the new FamilyAura row to Flutter
//
// RLS: family members can SELECT; only service_role can INSERT/UPDATE/DELETE.
// Realtime: FamilyAura + MemberAuraRole are in the supabase_realtime publication.
// ═══════════════════════════════════════════════════════════════════════════

/// Current AURA parameters for a family. One row per family.
/// Updated every time the family graph changes (debounced 2s).
model FamilyAura {
  id       String @id @default(cuid())
  familyId String @unique

  // ── Graph metrics (raw, for re-classification without recomputing) ──
  memberCount           Int     @default(0)
  generationDepth       Int     @default(1)
  edgeCount             Int     @default(0)
  clusteringCoefficient Decimal @default(0) @db.Decimal(6, 4)
  graphDiameter         Int     @default(0)
  avgDegree             Decimal @default(0) @db.Decimal(6, 3)
  maxBetweennessNode    String? // FK to Person — anchor member
  rootNode              String? // FK to Person — oldest ancestor
  distinctLineages      Int     @default(1)

  // ── Language distribution (JSONB: ISO-639-1 code → ratio, sums to 1.0) ──
  // Example: {"hi": 0.5, "ta": 0.3, "gu": 0.2}
  languageDistribution Json @default("{}")

  // ── AURA Symbol Parameters ──
  ringCount          Int     @default(2) // 1–8
  spokeCount         Int     @default(4) // 3–12
  innerPatternType   String  @default("lotus") // lotus|grid|diamond|star|web|spiral
  outerRingRadiusPct Decimal @default(0.85) @db.Decimal(4, 2) // 0.50–0.95
  patternComplexity  Int     @default(3) // 1–10
  primaryColorHex    String  @default("#C8853A") @db.Char(7)
  secondaryColorHex  String  @default("#6B3FA0") @db.Char(7)
  accentColorHex     String  @default("#2D8A4E") @db.Char(7)
  pulseSpeedMs       Int     @default(3000) // animation cycle duration

  // ── Archetype classification ──
  archetypeKey        String  @default("lotus") // banyan|river_delta|confluence|spine|lotus|forest
  archetypeConfidence Decimal @default(0.500) @db.Decimal(4, 3) // 0.000–1.000

  // ── Metadata ──
  computedAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family               Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  maxBetweennessPerson Person? @relation("PersonMaxBetweenness", fields: [maxBetweennessNode], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rootPerson           Person? @relation("PersonRootNode", fields: [rootNode], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([familyId])
}

/// Snapshot history of AURA parameters over time. Used by the AURA Timeline widget.
/// A new row is inserted every time the AURA is recomputed (debounced).
model FamilyAuraHistory {
  id       String @id @default(cuid())
  familyId String

  // ── Snapshot of the full AURA parameters at this point in time ──
  memberCount       Int
  generationDepth   Int
  archetypeKey      String
  ringCount         Int
  spokeCount        Int
  innerPatternType  String
  primaryColorHex   String @db.Char(7)
  secondaryColorHex String @db.Char(7)
  accentColorHex    String @db.Char(7)

  // ── Language distribution at this point in time (Bug 9 fix) ──
  // JSONB map: ISO-639-1 code → ratio (sums to 1.0). Stored so the
  // timeline can answer "which language dominated our family in 2025?".
  languageDistribution Json @default("{}")

  // ── What triggered this snapshot ──
  triggerMemberId  String? // FK to Person — who triggered the change (nullable for bulk recompute)
  triggerEventType String  @default("member_added")
  // Enum: member_added | member_removed | relationship_added | language_changed | manual_recompute

  // ── Whether this snapshot represents an archetype change ──
  archetypeChanged  Boolean @default(false)
  previousArchetype String?

  capturedAt DateTime @default(now()) @db.Timestamptz

  // ── Relations ──
  family        Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  triggerMember Person? @relation("PersonTriggerMember", fields: [triggerMemberId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([familyId, capturedAt(sort: Desc)])
}

/// Each member's computed role within the family AURA. One row per member per family.
/// Updated when graph changes affect role assignments.
model MemberAuraRole {
  id       String @id @default(cuid())
  familyId String
  memberId String

  // ── Role classification ──
  roleKey String @default("leaf")
  // Enum: root | anchor | bridge | weaver | leaf | twin_node

  // ── Graph metrics that determined this role (for debugging / display) ──
  betweennessScore Decimal @default(0) @db.Decimal(8, 6)
  degreeCount      Int     @default(0)
  generationIndex  Int     @default(0) // 0 = root generation

  // ── Role glyph visual parameters ──
  glyphShape    String @default("petal")
  // Enum: anchor | bridge | spiral | mirror | petal | deep_anchor
  glyphColorHex String @default("#C8853A") @db.Char(7)

  computedAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  member Person @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([familyId, memberId])
  @@index([familyId])
  @@index([memberId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PULSE — Daily Family Intelligence Brief
// ═══════════════════════════════════════════════════════════════════════════
// Six tables that power the daily 7am personalized family brief:
//   1. "DailyBrief"           — one row per user per day (the orchestrator output)
//   2. "BriefItem"            — individual items inside a brief (max 6 per brief)
//   3. "BriefInteraction"     — analytics: which item the user tapped + karma
//   4. "RelationshipWeather"  — per-pair emotional climate (sunny/cloudy/stormy)
//   5. "ConnectionStreak"     — daily-interaction streaks between pairs
//   6. "FamilyKarma"          — invisible social currency tied to AURA roles
//
// Migration: supabase/migrations/20260708020000_create_pulse_tables.sql (applied live)
// RLS: family members SELECT, service_role ALL on every table.
// Realtime: "DailyBrief" is in the supabase_realtime publication.
// ═══════════════════════════════════════════════════════════════════════════

/// One brief per user per day. Generated at 7am by PulseCronService.
/// The `content` JSONB holds the full structured brief for client rendering.
model DailyBrief {
  id       String @id @default(cuid())
  userId   String
  familyId String

  // ── The day this brief is for (DATE, not TIMESTAMPTZ — one brief per day) ──
  briefDate DateTime @db.Date

  // ── Header content ──
  greeting        String // e.g. "Good morning, Manish. Here's your family today."
  familyArchetype String // e.g. "confluence" (from AURA, or "unknown" if no AURA)
  languageCode    String @default("en") // ISO-639-1 code used for localization

  // ── Full structured brief payload (JSONB) ──
  // Schema: { items: BriefItemData[], summary: string, generatedAt: ISO }
  content Json

  // ── Lifecycle timestamps ──
  generatedAt  DateTime  @default(now()) @db.Timestamptz
  deliveredAt  DateTime? @db.Timestamptz // set when FCM push fires (Phase 3)
  viewedAt     DateTime? @db.Timestamptz // set when user opens the brief
  interactedAt DateTime? @db.Timestamptz // set when user taps any item
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  // ── Engagement analytics (updated as interactions arrive) ──
  interactionCount Int @default(0)
  callsInitiated   Int @default(0)
  messagesSent     Int @default(0)
  memoriesViewed   Int @default(0)
  karmaEarned      Int @default(0)

  // ── Relations ──
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  family Family      @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items  BriefItem[]

  @@unique([userId, briefDate])
  @@index([familyId, briefDate])
  @@index([userId, briefDate])
  @@index([briefDate])
}

/// A single item inside a DailyBrief. Max 6 per brief. Ordered by priority DESC.
/// Each item has an action (call/message/view_post/etc.) that the user can tap.
model BriefItem {
  id       String @id @default(cuid())
  briefId  String
  userId   String
  familyId String

  // ── Item type (enum-like, but stored as TEXT for forward compat) ──
  // need_you | birthday | feed_highlight | weather | memory_orbit | on_this_day
  itemType String

  // ── Priority (higher = earlier in the brief). Range 0-100. ──
  priority Int @default(50)

  // ── Localized display content ──
  title       String
  body        String
  actionLabel String // e.g. "Call her", "Send a message", "See photos"
  actionType  String // call | message | view_post | view_sparq | contribute | listen_memory

  // ── Action payload (JSONB, varies by actionType) ──
  // e.g. { phone: "+91..." } for call, { deepLink: "/post/abc" } for view_post
  actionData Json @default("{}")

  // ── Optional targets (nullable, set when item is about a specific entity) ──
  targetPersonId String?
  targetUserId   String?
  targetSparqId  String?
  targetPostId   String?

  // ── Personalization score (0.000-1.000, computed by Phase 2 graph logic) ──
  relevanceScore Decimal @default(0.500) @db.Decimal(4, 3)

  // ── Interaction tracking (denormalized for fast dashboard queries) ──
  interactedAt    DateTime? @db.Timestamptz
  interactionType String? // call | message | view | dismiss | skip

  createdAt DateTime @default(now()) @db.Timestamptz

  // ── Relations ──
  brief        DailyBrief         @relation(fields: [briefId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetPerson Person?            @relation("BriefItemTargetPerson", fields: [targetPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetUser   User?              @relation("BriefItemTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  interactions BriefInteraction[]

  @@index([briefId])
  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([itemType, priority])
}

/// Records each tap on a BriefItem. Used for analytics + karma computation.
model BriefInteraction {
  id              String   @id @default(cuid())
  briefItemId     String
  userId          String
  interactionType String // call | message | view | dismiss | skip
  interactionData Json     @default("{}") // e.g. { duration_sec: 120 } for call
  karmaAwarded    Int      @default(0)
  interactedAt    DateTime @default(now()) @db.Timestamptz

  // ── Relations ──
  briefItem BriefItem @relation(fields: [briefItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([briefItemId])
  @@index([userId, interactedAt])
}

/// Per-pair emotional climate. Computed nightly at 1am by PulseCronService.
/// One row per (userA, personB/userB) pair within a family.
/// `weather` ∈ sunny | partly_cloudy | cloudy | rainy | stormy
model RelationshipWeather {
  id       String @id @default(cuid())
  familyId String

  // ── Pair definition (mixed to support both Person and User targets) ──
  userAId   String
  personBId String? // set when the "other side" is a Person not yet linked to a User
  userBId   String? // set when the "other side" is a registered User

  // ── Computed weather ──
  weather              String // sunny | partly_cloudy | cloudy | rainy | stormy
  daysSinceLastContact Int       @default(0)
  interactionCount30d  Int       @default(0)
  sentimentScore       Decimal   @default(0.500) @db.Decimal(4, 3) // 0=neg, 1=pos
  streakDays           Int       @default(0)
  previousWeather      String?
  weatherChangedAt     DateTime? @db.Timestamptz
  computedAt           DateTime  @default(now()) @db.Timestamptz
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  // ── Relations ──
  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userA   User    @relation("WeatherUserA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  personB Person? @relation("WeatherPersonB", fields: [personBId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userB   User?   @relation("WeatherUserB", fields: [userBId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([familyId, userAId, personBId, userBId])
  @@index([familyId, userAId])
  @@index([userAId])
  @@index([userBId])
  @@index([weather])
}

/// Per-pair connection streak (days-in-a-row of any interaction).
/// Hooked into chat/call/sparq events in Phase 5.
model ConnectionStreak {
  id       String @id @default(cuid())
  familyId String

  // ── Pair definition (same mixed pattern as RelationshipWeather) ──
  userAId   String
  personBId String?
  userBId   String?

  // ── Streak counts ──
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastInteractionAt DateTime? @db.Timestamptz
  streakStartedAt   DateTime? @db.Timestamptz
  streakBrokenAt    DateTime? @db.Timestamptz

  // ── Streak type ──
  streakType String @default("any") // any | call | message | sparq_view

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userA   User    @relation("StreakUserA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  personB Person? @relation("StreakPersonB", fields: [personBId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userB   User?   @relation("StreakUserB", fields: [userBId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([familyId, userAId, personBId, userBId, streakType])
  @@index([familyId, userAId])
  @@index([userAId])
  @@index([currentStreak])
}

/// Family Karma — invisible social currency per user per family.
/// Tied to AURA roles: karma awarded differs by role (root/anchor/bridge/weaver/leaf).
/// Updated whenever a BriefInteraction is recorded.
model FamilyKarma {
  id       String @id @default(cuid())
  userId   String
  familyId String

  // ── Aggregate counters ──
  totalKarma     Int    @default(0)
  karmaThisWeek  Int    @default(0)
  karmaThisMonth Int    @default(0)
  karmaTrend     String @default("steady") // up | steady | down

  // ── Karma broken down by AURA role (debugging + future gamification) ──
  karmaAsRoot   Int @default(0)
  karmaAsAnchor Int @default(0)
  karmaAsBridge Int @default(0)
  karmaAsWeaver Int @default(0)
  karmaAsLeaf   Int @default(0)

  // ── Recent karma reasons (JSONB array, last 10) ──
  // Schema: [{ amount, reason, timestamp, roleKey }]
  recentReasons Json @default("[]")

  lastKarmaAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  // ── Relations ──
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, familyId])
  @@index([familyId, totalKarma])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PITRU — Ancestral Voice Memory
// ═══════════════════════════════════════════════════════════════════════════
// Four tables that power the "forever lock-in" feature:
//   1. "AncestralMemory"  — voice/video memory + AI transcription/translation/tags
//   2. "MemoryTag"         — many-to-many between memories and Persons
//   3. "MemoryConsent"     — consent records for AI persona / voice cloning
//   4. "MemorialProfile"   — memorial page config for deceased Persons
//
// Migration: supabase/migrations/20260708030000_create_pitru_tables.sql (applied live)
// RLS: family-scoped SELECT, service_role ALL on every table.
// Realtime: "AncestralMemory" is in the supabase_realtime publication.
// ═══════════════════════════════════════════════════════════════════════════

/// A voice/video memory recorded by a family elder (or on their behalf).
/// AI processes it asynchronously: Whisper transcription, GPT translation + summary.
/// When the elder passes away, their memories become part of their MemorialProfile.
model AncestralMemory {
  id            String  @id @default(cuid())
  familyId      String
  recorderId    String // User who recorded/uploaded
  elderPersonId String? // Person the memory is about (nullable: elder may not be in graph yet)

  // ── Media storage ──
  mediaType    String  @default("audio") // audio | video
  mediaUrl     String
  thumbnailUrl String?
  durationSec  Int     @default(0)

  // ── Title + topic (user-provided) ──
  title       String
  topic       String?
  language    String  @default("en")
  description String?

  // ── AI processing results ──
  transcript         String?
  transcriptLanguage String?
  translation        String?
  aiSummary          String?
  aiTags             Json      @default("[]")
  aiProcessedAt      DateTime? @db.Timestamptz
  aiProcessingError  String?

  // ── Lifecycle ──
  status     String    @default("pending") // pending | processing | ready | failed | archived
  isPublic   Boolean   @default(false)
  revealAt   DateTime? @db.Timestamptz
  isRevealed Boolean   @default(true)

  // ── Engagement ──
  viewCount      Int       @default(0)
  listenCount    Int       @default(0)
  lastListenedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recorder    User        @relation("MemoryRecorder", fields: [recorderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elderPerson Person?     @relation("MemoryElderPerson", fields: [elderPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tags        MemoryTag[]

  @@index([familyId, createdAt(sort: Desc)])
  @@index([elderPersonId])
  @@index([status])
  @@index([topic])
}

/// Many-to-many between AncestralMemory and Person.
/// Records who is mentioned/featured in each memory.
model MemoryTag {
  id         String   @id @default(cuid())
  memoryId   String
  personId   String
  taggedById String? // User who applied the tag
  tagType    String   @default("mentions") // mentions | about | recorded_by | featured
  taggedAt   DateTime @default(now()) @db.Timestamptz

  memory   AncestralMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person   Person          @relation("MemoryTagPerson", fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  taggedBy User?           @relation("MemoryTaggedBy", fields: [taggedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([memoryId, personId, tagType])
  @@index([memoryId])
  @@index([personId])
}

/// Consent records for AI persona / voice cloning / public memorial.
/// CRITICAL: Without explicit consent, AI persona features are disabled for that person.
model MemoryConsent {
  id               String    @id @default(cuid())
  familyId         String
  elderPersonId    String
  consentType      String // ai_persona | voice_cloning | public_memorial | cross_family_share
  consentGiven     Boolean   @default(false)
  consentedById    String?
  consentedAt      DateTime? @db.Timestamptz
  consentExpiresAt DateTime? @db.Timestamptz
  consentNotes     String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  family      Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elderPerson Person @relation("ConsentElderPerson", fields: [elderPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  consentedBy User?  @relation("ConsentConsentedBy", fields: [consentedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([elderPersonId, consentType])
  @@index([elderPersonId])
  @@index([familyId])
}

/// Memorial page config for deceased Persons.
/// One row per deceased Person. Created when isDeceased is set to true.
model MemorialProfile {
  id               String    @id @default(cuid())
  familyId         String
  personId         String
  memorialTitle    String?
  memorialBio      String?
  birthDate        DateTime? @db.Date
  deathDate        DateTime? @db.Date
  coverPhotoUrl    String?
  isPublic         Boolean   @default(false)
  allowMessages    Boolean   @default(true)
  aiPersonaEnabled Boolean   @default(false) // requires MemoryConsent ai_persona

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person Person @relation("MemorialPerson", fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([personId])
  @@index([familyId])
}

// ═══════════════════════════════════════════════════════════════════════════
// A-6 FESTIVAL INTELLIGENCE + A-1 BLESSING CHAIN + A-2 TIME CAPSULE
// ═══════════════════════════════════════════════════════════════════════════
// Three addictiveness features that share cultural timing logic:
//   1. "Festival"      — Indian festival calendar (8 languages, fixed + lunar)
//   2. "BlessingChain"  — elder blessings scheduled for birthdays/festivals
//   3. "TimeCapsule"    — messages locked until a future reveal date
//
// Migration: supabase/migrations/20260708040000_create_festival_blessing_timecapsule_tables.sql
// RLS: Festival is public SELECT; BlessingChain + TimeCapsule are family-scoped.
// ═══════════════════════════════════════════════════════════════════════════

/// Indian festival with 8-language names + greetings.
/// Pre-computed dates for the next 3 years (lunar festivals are pre-computed
/// because runtime Hindu calendar math is complex).
model Festival {
  id           String   @id @default(cuid())
  festivalKey  String   @unique
  dateType     String   @default("lunar") // fixed | lunar
  festivalDate DateTime @db.Date
  region       String   @default("all") // north | south | east | west | all

  // ── Names + greetings in 8 languages (JSONB) ──
  // Schema: { "en": {name, greeting}, "hi": {name, greeting}, ... }
  names     Json @default("{}")
  greetings Json @default("{}")

  // ── Cultural context ──
  description String?
  themes      Json    @default("[]") // ["lights","victory","harvest"]
  rituals     Json    @default("[]") // ["rangoli","puja","sweets"]

  // ── Scheduling metadata ──
  daysUntil Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([festivalDate])
  @@index([daysUntil])
  @@index([region])
}

/// Elder blessing scheduled for delivery on a birthday/festival/anniversary.
/// Recurring blessings re-deliver every year on the trigger date.
model BlessingChain {
  id                String  @id @default(cuid())
  familyId          String
  elderPersonId     String
  elderUserId       String?
  recipientPersonId String?
  recipientUserId   String?

  // ── Content ──
  mediaType   String  @default("text") // text | audio
  textContent String?
  mediaUrl    String?
  durationSec Int     @default(0)

  // ── Scheduling ──
  triggerType String // birthday | festival | anniversary | custom
  triggerDate DateTime @db.Date
  festivalKey String?

  // ── Localization ──
  language String @default("en")

  // ── Lifecycle ──
  status          String    @default("pending") // pending | delivered | viewed | cancelled
  deliveredAt     DateTime? @db.Timestamptz
  viewedAt        DateTime? @db.Timestamptz
  cancelledAt     DateTime? @db.Timestamptz
  cancelledReason String?

  // ── Recurrence ──
  isRecurring     Boolean   @default(false)
  lastDeliveredAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family          Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elderPerson     Person  @relation("BlessingElderPerson", fields: [elderPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elderUser       User?   @relation("BlessingElderUser", fields: [elderUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipientPerson Person? @relation("BlessingRecipientPerson", fields: [recipientPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientUser   User?   @relation("BlessingRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([familyId])
  @@index([elderPersonId])
  @@index([recipientPersonId, recipientUserId])
  @@index([triggerDate, status])
  @@index([status])
}

/// Message locked until a future reveal date.
/// For 18th birthdays, weddings, after passing, etc.
model TimeCapsule {
  id                String  @id @default(cuid())
  familyId          String
  creatorId         String
  recipientPersonId String?
  recipientUserId   String?

  // ── Content ──
  mediaType    String  @default("text") // text | photo | video
  textContent  String?
  mediaUrl     String?
  thumbnailUrl String?

  // ── The reveal ──
  title        String
  revealAt     DateTime @db.Timestamptz
  revealReason String?

  // ── Lifecycle ──
  status      String    @default("locked") // locked | revealed | viewed | cancelled
  revealedAt  DateTime? @db.Timestamptz
  viewedAt    DateTime? @db.Timestamptz
  cancelledAt DateTime? @db.Timestamptz

  // ── Notification ──
  notifyOnReveal Boolean   @default(true)
  notifiedAt     DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // ── Relations ──
  family          Family  @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator         User    @relation("TimeCapsuleCreator", fields: [creatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientPerson Person? @relation("TimeCapsuleRecipientPerson", fields: [recipientPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipientUser   User?   @relation("TimeCapsuleRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([familyId])
  @@index([creatorId])
  @@index([recipientPersonId, recipientUserId])
  @@index([revealAt])
  @@index([status])
}

