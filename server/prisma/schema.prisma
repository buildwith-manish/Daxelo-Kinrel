// DAXELO KINREL — Prisma Schema
// Pack 01: Design System + Pack 02: Support & Operations + Pack 04: WhatsApp Platform
// Pack 06: Accessibility + Pack 07: Developer API + Pack 08: Content Moderation
// Pack 09: Community & Social + Pack 12: Brand & Motion
// + Family-Graph-First Redesign

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  free
  pro_monthly
  pro_annual
  family_annual
  lifetime
}

enum AgentStatus {
  online
  busy
  offline
  on_break
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketSeverity {
  critical
  high
  medium
  low
}

enum TicketCategory {
  billing
  account
  data_loss
  bug
  feature_request
  general
  matrimonial
  verification
  privacy
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  past_due
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SparqType {
  IMAGE
  VIDEO
  TEXT
  VOICE
}

enum SparqAudience {
  PUBLIC
  FAMILY_ONLY
  VIP_CIRCLE
}

enum SparqMood {
  happy
  hype
  love
  sad
  celebrate
  angry
}

enum SparqIntensity {
  calm
  warm
  fire
}

// ── Core Models ──────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  username          String?   @unique // Unique @username for display
  passwordHash      String? // bcrypt hash for credentials auth (was SHA-256, now auto-upgraded)
  avatarUrl         String? // User profile avatar (base64 data URL or remote URL)
  photoThumb        String? // Avatar thumb: w_80,h_80,c_fill,q_auto,f_auto
  photoCard         String? // Avatar card: w_150,h_150,c_fill,q_auto,f_auto
  photoFull         String? // Avatar full: w_400,h_400,c_fill,q_auto,f_webp
  bio               String? // Short biography
  dateOfBirth       DateTime? // User's date of birth
  gender            String? // male, female, other, prefer_not_to_say
  profileVisibility String    @default("public") // public, private, connections_only
  invitePermission  String    @default("anyone") // anyone, connections, nobody
  authProvider      String    @default("email") // email, google, apple, phone
  twoFactorEnabled  Boolean   @default(false) // Whether 2FA is enabled
  twoFactorSecret   String? // TOTP base32 secret for 2FA
  preferredLanguage String    @default("en")
  role              String    @default("user") // user, admin, agent
  phone             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscription         Subscription?
  supportTickets       SupportTicket[]          @relation("SupportTicketUser")
  supportAgent         SupportAgent?
  authoredArticles     KBArticle[]              @relation("KBArticleAuthor")
  editedArticles       KBArticle[]              @relation("KBArticleEditor")
  onCallSchedules      OnCallSchedule[]
  incidents            Incident[]               @relation("IncidentAuthor")
  whatsappConsent      WhatsAppConsent?
  notificationPrefs    NotificationPreference[]
  notifications        Notification[]
  sentInvitations      Invitation[]             @relation("InvitationInviter")
  families             FamilyMember[]
  apiKeys              ApiKey[]
  oauthClients         OAuthClient[]
  communityMemberships CommunityMember[]
  communityPosts       CommunityPost[]
  reactions            Reaction[]
  comments             Comment[]
  eventRSVPs           EventRSVP[]
  contributions        UserContribution[]
  userBadges           UserBadge[]
  contentReports       ContentReport[]          @relation("ReportsMade")
  resolvedReports      ContentReport[]          @relation("ReportsResolved")
  moderationActions    ModerationAction[]
  moderationStatus     UserModerationStatus?
  parentalConsents     ParentalConsent[]
  appealAppellant      ModerationAppeal[]       @relation("AppealAppellant")
  appealReviewer       ModerationAppeal[]       @relation("AppealReviewer")
  refreshTokens        RefreshToken[]
  fcmTokens            FcmToken[]
  usernameChangeLog    UsernameChangeLog[]
  blockedUsers         BlockedUser[]            @relation("Blocker")
  blockedBy            BlockedUser[]            @relation("Blocked")
  stories              Story[]

  // ── Social System Fields ──
  isPrivate           Boolean @default(false) // Profile privacy: true = follow requests required
  isFamilyGraphPublic Boolean @default(true) // Family tree visibility to non-members

  // ── Social System Relations ──
  followers      Follow[]       @relation("UserFollowers")
  following      Follow[]       @relation("UserFollowing")
  sparqs         Sparq[]
  sparqViews     SparqView[]
  sparqEchoes    SparqEcho[]
  createdInvites FamilyInvite[] @relation("UserCreatedInvites")

  // ── v2.2 Viewer-Driven Relationship Engine ──
  // The Person node this user has claimed / been linked to.
  // At most one Person per User (enforced by Person.linkedUserId @unique).
  linkedPerson Person? @relation("PersonUserLink")

  // ── v2.2: Person-Link Invitations sent by this user ──
  sentLinkInvitations PersonLinkInvitation[] @relation("PersonLinkInvitationInviter")

  // ── PULSE back-relations ──
  dailyBriefs        DailyBrief[]
  briefItems         BriefItem[]
  briefInteractions  BriefInteraction[]
  karmaEntries       FamilyKarma[]
  weatherAsA         RelationshipWeather[] @relation("WeatherUserA")
  weatherAsB         RelationshipWeather[] @relation("WeatherUserB")
  streaksAsA         ConnectionStreak[]    @relation("StreakUserA")
  streaksAsB         ConnectionStreak[]    @relation("StreakUserB")
  briefItemsAsTarget BriefItem[]           @relation("BriefItemTargetUser")

  // ── PITRU back-relations ──
  recordedMemories    AncestralMemory[] @relation("MemoryRecorder")
  memoryTagsApplied   MemoryTag[]       @relation("MemoryTaggedBy")
  memoryConsentsGiven MemoryConsent[]   @relation("ConsentConsentedBy")

  // ── A-1/A-2 back-relations (Blessing Chain + Time Capsule) ──
  blessingsAsElder     BlessingChain[] @relation("BlessingElderUser")
  blessingsAsRecipient BlessingChain[] @relation("BlessingRecipientUser")
  timeCapsulesCreated  TimeCapsule[]   @relation("TimeCapsuleCreator")
  timeCapsulesForMe    TimeCapsule[]   @relation("TimeCapsuleRecipientUser")

  // ── A-3/A-4 back-relations (Quests + Silent Alarms) ──
  quests             FamilyQuest[] @relation("QuestUser")
  questsAsTarget     FamilyQuest[] @relation("QuestTargetUser")
  alarmsAsInactive   SilentAlarm[] @relation("AlarmInactiveUser")
  alarmsAsBridge     SilentAlarm[] @relation("AlarmBridgeUser")
  alarmsAcknowledged SilentAlarm[] @relation("AlarmAcknowledgedBy")
}

// ── Blocked Users (replaces JSON blockedUserIds anti-pattern) ────────

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// ── Pack 02: Subscription & Support Tier ─────────────────────────────

model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  plan        SubscriptionPlan   @default(free)
  status      SubscriptionStatus @default(active)
  supportTier String             @default("basic") // basic, standard, premium, vip
  startDate   DateTime           @default(now())
  endDate     DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tickets SupportTicket[] @relation("SupportTicketSubscription")

  @@index([userId, status])
  @@index([supportTier])
}

// ── Pack 02: Support Agent ───────────────────────────────────────────

model SupportAgent {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])
  name   String
  email  String
  phone  String?

  // Agent configuration (stored as JSON strings)
  status    AgentStatus @default(offline)
  queues    String[]    @default([])
  minTier   Int         @default(1) // Minimum tier weight this agent handles
  languages String[]    @default([])

  // Load tracking
  currentLoad Int @default(0)
  maxLoad     Int @default(10)

  // Schedule
  onCallUntil DateTime?
  nextShift   DateTime?

  // Stats
  avgResponseTime   Int   @default(0) // minutes
  avgResolutionTime Int   @default(0) // minutes
  satisfactionScore Float @default(0) // 0-5
  ticketsResolved   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTickets SupportTicket[] @relation("AssignedAgent")

  @@index([status, currentLoad])
}

// ── Pack 02: Ticketing System ────────────────────────────────────────

model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique // DK-2024-00001
  userId       String
  user         User   @relation("SupportTicketUser", fields: [userId], references: [id], map: "SupportTicket_user_fkey")

  // Classification
  category    TicketCategory @default(general)
  subcategory String?
  severity    TicketSeverity @default(medium)
  priority    Int            @default(1) // 1-100

  // Content
  subject     String
  description String
  attachments String[] @default([])
  appVersion  String?
  platform    String? // android, ios, web
  deviceInfo  String? // JSON string

  // State
  status         TicketStatus @default(open)
  resolution     String?
  resolutionType String? // resolved, wont_fix, duplicate, no_response, out_of_scope

  // Subscription reference
  subscription Subscription? @relation("SupportTicketSubscription", fields: [userId], references: [userId], map: "SupportTicket_subscription_fkey")

  // Assignment
  assignedAgentId String?
  assignedAgent   SupportAgent? @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  queue           String        @default("general")

  // SLA tracking
  slaTier               String    @default("basic")
  firstResponseAt       DateTime?
  firstResponseDeadline DateTime?
  resolutionDeadline    DateTime?
  slaBreached           Boolean   @default(false)

  // Language
  language String @default("en")

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  // Relations
  messages    SupportMessage[]
  escalations SupportEscalation[]
  csat        SupportCSAT?
  slaRecords  SLATracking[]

  @@index([userId, status])
  @@index([assignedAgentId, status])
  @@index([status, priority])
  @@index([category, status])
  @@index([slaBreached])
  @@index([createdAt])
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderType String  @default("user") // user, agent, system
  senderId   String?
  senderName String

  content     String
  attachments String[] @default([])
  isInternal  Boolean  @default(false)

  // Metadata
  channel  String @default("in_app") // in_app, email, whatsapp, phone
  language String @default("en")

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model SupportEscalation {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  fromAgentId String?
  toAgentId   String?
  reason      String // sla_breach, complexity, user_request, supervisor_review
  notes       String?

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model SupportCSAT {
  id       String        @id @default(cuid())
  ticketId String        @unique
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

// ── Pack 02: SLA Tracking ────────────────────────────────────────────

model SLATracking {
  id       String         @id @default(cuid())
  ticketId String?
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id])

  // SLA type
  type String // first_response, update, resolution, uptime
  tier String // basic, standard, premium, vip

  // Deadlines
  deadline       DateTime
  metAt          DateTime?
  breached       Boolean   @default(false)
  breachDuration Int? // Minutes past deadline

  // Uptime-specific
  downtimeStart   DateTime?
  downtimeEnd     DateTime?
  downtimeMinutes Int?

  createdAt DateTime @default(now())

  @@index([type, tier, breached])
  @@index([deadline])
}

// ── Pack 02: On-Call Rotation ────────────────────────────────────────

model OnCallSchedule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  role      String // primary, secondary
  weekStart DateTime // Monday 00:00 IST
  weekEnd   DateTime // Sunday 23:59 IST

  // Tracking
  incidentsHandled Int     @default(0)
  avgAckTime       Int     @default(0) // seconds
  avgResolveTime   Int     @default(0) // minutes
  compensationPaid Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, weekStart, role])
  @@index([weekStart, role])
}

// ── Pack 02: Incident Communication ──────────────────────────────────

model Incident {
  id             String @id @default(cuid())
  incidentNumber String @unique // INC-2024-00001
  title          String
  description    String

  // Status
  status   String @default("investigating") // investigating, identified, monitoring, resolved
  severity String // critical, high, medium, low

  // Affected components (JSON array)
  affectedComponents String @default("[]")

  // Timeline
  startedAt    DateTime  @default(now())
  identifiedAt DateTime?
  monitoringAt DateTime?
  resolvedAt   DateTime?

  // Communication
  initialNotificationSent    Boolean @default(false)
  resolutionNotificationSent Boolean @default(false)

  // Author
  authorId String
  author   User   @relation("IncidentAuthor", fields: [authorId], references: [id])

  // Post-mortem
  postMortem PostMortem?

  updates   IncidentUpdate[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, startedAt])
  @@index([severity, status])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  status     String // investigating, identified, monitoring, resolved
  message    String
  authorId   String
  authorName String

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
}

model PostMortem {
  id         String   @id @default(cuid())
  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id])

  // Sections
  summary       String
  timeline      String
  rootCause     String
  impact        String
  whatWentWell  String
  whatWentWrong String
  actionItems   String @default("[]") // JSON array

  // Meta
  authorId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([completedAt])
}

model IncidentSubscriber {
  id     String  @id @default(cuid())
  email  String?
  phone  String? // WhatsApp number
  userId String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

// ── Pack 02: Knowledge Base ──────────────────────────────────────────

model KBArticle {
  id   String @id @default(cuid())
  slug String @unique

  // Category
  category    String  @default("general") // getting_started, family_tree, relationships, subscriptions, matrimonial, whatsapp, privacy, account, troubleshooting
  subcategory String?
  sortOrder   Int     @default(0)

  // Content (localized JSON strings)
  title   String @default("{}") // JSON: {"en": "...", "hi": "..."}
  content String @default("{}") // JSON: {"en": "...", "hi": "..."}
  excerpt String @default("{}") // JSON: {"en": "...", "hi": "..."}

  // Metadata
  tags              String[] @default([])
  relatedArticleIds String[] @default([])

  // Status
  status   String  @default("draft") // draft, published, archived
  featured Boolean @default(false)

  // Analytics
  views             Int @default(0)
  helpfulYes        Int @default(0)
  helpfulNo         Int @default(0)
  searchAppearances Int @default(0)
  clickThroughs     Int @default(0)

  // Authorship
  authorId       String
  author         User    @relation("KBArticleAuthor", fields: [authorId], references: [id])
  lastEditedById String?
  lastEditedBy   User?   @relation("KBArticleEditor", fields: [lastEditedById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  searchLogs KBSearchLog[]

  @@index([category, status, sortOrder])
  @@index([status, publishedAt])
}

model KBSearchLog {
  id       String  @id @default(cuid())
  query    String
  language String  @default("en")
  userId   String?

  // Results
  resultsCount     Int
  clickedArticleId String?
  clickedArticle   KBArticle? @relation(fields: [clickedArticleId], references: [id])

  // Did this search lead to a support ticket?
  ledToTicket Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([query, language])
  @@index([createdAt])
  @@index([ledToTicket])
}

// ── Pack 04: WhatsApp Platform ──────────────────────────────────────

// Family & Person models (foundation for WhatsApp features + Graph-First redesign)

model Family {
  id              String   @id @default(cuid())
  name            String
  description     String?
  primaryLanguage String   @default("en")
  gotra           String? // Hindu gotra identifier
  originVillage   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Graph-First Redesign Fields ──
  familyCode      String    @unique @default(cuid()) // Shareable family ID like Instagram handle
  kinFamilyId     String?   @unique // Human-readable Family ID: KIN-AB12CD34 (Feature 1: Family ID System)
  username        String?   @unique // Unique @username for display (e.g. @sharmw)
  avatarUrl       String?
  region          String?
  privacyMode     String    @default("private") // private/invite/link
  isOnboarded     Boolean   @default(false)
  anchorPersonId  String? // The primary household anchor person
  memberCount     Int       @default(0)
  generationCount Int       @default(1)
  lastActivityAt  DateTime  @default(now())
  createdBy       String? // User ID who created this family
  deletedAt       DateTime? // Soft-delete: archived for 30 days before permanent deletion

  members          FamilyMember[]
  persons          Person[]
  invitations      Invitation[]
  familyInvites    FamilyInvite[]
  graphLayouts     GraphLayoutState[]
  graphChangeLogs  GraphChangeLog[]
  feedPosts        FamilyPost[]
  stories          Story[]
  graphStateCaches GraphStateCache[]

  // ── v2.2: Person-Link Invitations for this family ──
  personLinkInvitations PersonLinkInvitation[]

  // ── AURA: Ancestral Unified Relationship Archetype ──
  // One-to-one: each family has at most one current AURA snapshot.
  familyAura      FamilyAura?
  // One-to-many: historical AURA snapshots for the Timeline widget.
  auraHistory     FamilyAuraHistory[]
  // One-to-many: per-member role glyph classifications within this family's AURA.
  memberAuraRoles MemberAuraRole[]

  // ── PULSE back-relations ──
  dailyBriefs    DailyBrief[]
  briefItems     BriefItem[]
  weatherEntries RelationshipWeather[]
  streaks        ConnectionStreak[]
  karmaEntries   FamilyKarma[]

  // ── PITRU back-relations ──
  ancestralMemories AncestralMemory[]
  memoryConsents    MemoryConsent[]
  memorialProfiles  MemorialProfile[]

  // ── A-1/A-2 back-relations (Blessing Chain + Time Capsule) ──
  blessings    BlessingChain[]
  timeCapsules TimeCapsule[]

  // ── A-3/A-4/A-7 back-relations (Quests + Alarms + Chronicle) ──
  quests    FamilyQuest[]
  alarms    SilentAlarm[]
  chronicle FamilyChronicle?

  // ── Social System Fields ──
  isPublic Boolean @default(false) // Family visibility: true = non-members can see tree (read-only)

  @@index([name])
  @@index([familyCode])
  @@index([username])
  @@index([kinFamilyId])
  @@index([deletedAt])
}

model FamilyMember {
  id       String @id @default(cuid())
  familyId String
  userId   String
  role     String @default("member") // owner, admin, member, viewer

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  createdInvites FamilyInvite[]

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
}

model Person {
  id           String    @id @default(cuid())
  familyId     String
  name         String
  dateOfBirth  DateTime?
  gotra        String?
  occupation   String?
  city         String?
  isDeceased   Boolean   @default(false)
  privacyLevel String    @default("family") // family, extended, public
  deletedAt    DateTime? // Soft delete — null means active

  // ── Graph-First Redesign Fields ──
  birthYear       Int?
  notes           String?
  sideOfFamily    String? // paternal/maternal/both
  generationIndex Int     @default(0)
  isAnchor        Boolean @default(false)
  photoUrl        String?
  photoThumb      String? // Photo thumb: w_80,h_80,c_fill,q_auto,f_auto
  photoCard       String? // Photo card: w_150,h_150,c_fill,q_auto,f_auto
  photoFull       String? // Photo full: w_400,h_400,c_fill,q_auto,f_webp
  gender          String? // male, female, other
  username        String? // Unique @username for display

  // ── Full Member Profile Fields ──
  bloodGroup      String? // A+, A-, B+, B-, AB+, AB-, O+, O-
  education       String? // Education details
  biography       String? // Long biography text
  email           String? // Contact email
  phone           String? // Contact phone
  address         String? // Contact address (JSON: {street, city, state, country, zip})
  anniversaryDate DateTime? // Marriage/wedding anniversary
  latitude        Float?
  longitude       Float?
  location_name   String?   @map("location_name")
  visibility      String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // ── v2.2 Viewer-Driven Relationship Engine ──
  // Links this Person node to the authenticated User who "owns" it.
  // One User may be linked to at most one Person (enforced by @unique).
  // This is the foundation of the viewer system: every logged-in member
  // sees the family graph from THEIR OWN perspective via this link.
  linkedUserId String?   @unique
  linkedAt     DateTime?
  linkedUser   User?     @relation("PersonUserLink", fields: [linkedUserId], references: [id])

  // ── v2.2: Person-Link Invitations targeting this Person ──
  linkInvitations PersonLinkInvitation[] @relation("PersonLinkInvitationPerson")

  relationshipsFrom Relationship[] @relation("RelationshipFrom")
  relationshipsTo   Relationship[] @relation("RelationshipTo")

  feedPosts       FamilyPost[]
  privacySettings PersonPrivacySetting?

  // ── Graph V2.1 backward relations ──
  graphStateCaches    GraphStateCache[]
  blocksInitiated     Block[]           @relation("BlockBlocker")
  blocksReceived      Block[]           @relation("BlockBlocked")
  permissionsGranted  Permission[]      @relation("PermissionGrantor")
  permissionsReceived Permission[]      @relation("PermissionGrantee")

  // ── AURA back-relations ──
  // A Person can be the anchor (max betweenness) of multiple FamilyAura rows
  // (one per family they belong to — typically one, but Prisma requires a list
  // because maxBetweennessNode is not @unique on FamilyAura).
  anchoredFamilyAura   FamilyAura[]        @relation("PersonMaxBetweenness")
  // A Person can be the root (oldest ancestor) of multiple FamilyAura rows.
  rootedFamilyAura     FamilyAura[]        @relation("PersonRootNode")
  // A Person can be the trigger of multiple FamilyAuraHistory snapshots over time.
  triggeredAuraHistory FamilyAuraHistory[] @relation("PersonTriggerMember")
  // A Person has at most one MemberAuraRole per family — but Prisma infers
  // one-to-many from the non-unique memberId FK, so it's a list.
  auraRoles            MemberAuraRole[]

  // ── PULSE back-relations ──
  briefItemsAsTarget BriefItem[]           @relation("BriefItemTargetPerson")
  weatherAsPersonB   RelationshipWeather[] @relation("WeatherPersonB")
  streaksAsPersonB   ConnectionStreak[]    @relation("StreakPersonB")

  // ── PITRU back-relations ──
  memoriesAsElder AncestralMemory[] @relation("MemoryElderPerson")
  memoryTags      MemoryTag[]       @relation("MemoryTagPerson")
  memoryConsents  MemoryConsent[]   @relation("ConsentElderPerson")
  memorialProfile MemorialProfile?  @relation("MemorialPerson")

  // ── A-1/A-2 back-relations (Blessing Chain + Time Capsule) ──
  blessingsAsElder        BlessingChain[] @relation("BlessingElderPerson")
  blessingsAsRecipient    BlessingChain[] @relation("BlessingRecipientPerson")
  timeCapsulesAsRecipient TimeCapsule[]   @relation("TimeCapsuleRecipientPerson")

  // ── A-3/A-4 back-relations (Quests + Silent Alarms) ──
  questsAsTarget   FamilyQuest[] @relation("QuestTargetPerson")
  alarmsAsInactive SilentAlarm[] @relation("AlarmInactivePerson")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, name])
  @@index([familyId, dateOfBirth])
  @@index([deletedAt])
  @@index([familyId, generationIndex])
  @@index([familyId, isAnchor])
  @@index([linkedUserId])
  @@index([username])
  @@index([familyId])
  @@index([familyId, deletedAt])
  @@index([updatedAt])
}

// ── Graph V2.1: State Cache ─────────────────────────────────────────
// Stores pre-computed family graph snapshots for fast RPC retrieval.
// Rows expire after 30 minutes (see expires_at default) and are also
// invalidated by the expire_graph_cache() RPC function.

model GraphStateCache {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String
  memberId        String
  graphData       Json
  nodeCount       Int       @default(0)
  disclosureLevel Int       @default(1)
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @default(now())
  // expiresAt default is `(now() + '00:30:00'::interval)` set via raw SQL in
  // migration 20260612180545_graph_v2_1_step7_expire_cache_fn — Prisma can't
  // express interval arithmetic in @default, so we omit it here. Inserts via
  // raw SQL / RPC will get the default; Prisma inserts should set it explicitly.
  expiresAt       DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Person @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([familyId, memberId, disclosureLevel])
  @@index([memberId])
  @@index([expiresAt])
  @@map("graph_state_cache")
}

// ── Graph V2.1: Block (user-to-user block) ──────────────────────────
// Prevents one person from seeing/interacting with another in the graph.
// CHECK constraint enforces blocker_id <> blocked_id.

model Block {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String
  blockedId String
  createdAt DateTime? @default(now())

  blocker Person @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Person @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

// ── Graph V2.1: Permission grants ───────────────────────────────────
// Per-pair permissions for graph operations (view_profile, expand_branch,
// edit_relationship, view_relationship, admin). CHECK constraint on
// permission_type is enforced at the DB level.

model Permission {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantorId      String
  granteeId      String
  permissionType String
  createdAt      DateTime? @default(now())

  grantor Person @relation("PermissionGrantor", fields: [grantorId], references: [id], onDelete: Cascade)
  grantee Person @relation("PermissionGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([grantorId, granteeId, permissionType])
  @@index([grantorId])
  @@index([granteeId])
  @@map("permissions")
}

// WhatsApp Template Management

model WhatsAppTemplate {
