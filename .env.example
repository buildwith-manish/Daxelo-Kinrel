# Turso (libSQL) database credentials
# Get these from https://turso.io/app -> your database -> Settings
TURSO_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Optional: GitHub PAT for automation scripts
# Get from https://github.com/settings/tokens (classic) with `repo` scope
GITHUB_TOKEN=your-github-pat-here
