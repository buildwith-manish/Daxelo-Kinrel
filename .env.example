# Turso (libSQL) database credentials
# Get these from https://turso.io/app -> your database -> Settings
TURSO_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-token-here

# ── 2026-10-19 (Phase 1 Security): script credentials ──────────────
# The e2e test scripts (scripts/e2e-test.js, scripts/e2e-verify.js,
# scripts/setup_turso_table.py) read these from the environment.
# NEVER commit actual values — these are secrets that must be rotated
# if they were ever in git history (see docs/security/ROTATE_KEYS.md).

# Supabase service_role JWT (NOT the anon/publishable key).
# Used by: scripts/e2e-test.js, scripts/e2e-verify.js
# Get from: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-here

# Supabase database connection string (pooler, port 6543 for runtime).
# Used by: scripts/e2e-verify.js
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-1-region.pooler.supabase.com:6543/postgres

# Optional: GitHub PAT for automation scripts
# Get from https://github.com/settings/tokens (classic) with `repo` scope
GITHUB_TOKEN=your-github-pat-here
