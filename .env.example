# ══════════════════════════════════════════════════════════════════════
# DAXELO KINREL — Root Environment Variables Reference
# Copy this file to .env and fill in all values
# NEVER commit .env to git
# ══════════════════════════════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Add ?connection_limit=10&pool_timeout=20 to tune the Prisma connection pool for production
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="minimum-32-character-random-string-change-me"
JWT_REFRESH_SECRET="different-minimum-32-character-random-string"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── 2FA Encryption (AES-256) ──────────────────────────────────
ENCRYPTION_KEY="64-character-hex-string-for-aes-256-encryption"

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Firebase (Push Notifications + Admin SDK) ─────────────────
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@project.iam.gserviceaccount.com"

# ── AI / LLM (DeepSeek) ───────────────────────────────────────
DEEPSEEK_API_KEY="sk-..."

# ── Cloudinary (Image Storage + CDN) ─────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret-here"

# ── Payments ──────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@daxelokinrel.com"
SMTP_PASS="your-app-specific-password"

# ── WhatsApp Business API ─────────────────────────────────────
WHATSAPP_API_URL="https://api.whatsapp.com/v1"
WHATSAPP_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# ── App Config ────────────────────────────────────────────────
APP_URL="https://api.daxelokinrel.com"
FRONTEND_URL="https://daxelokinrel.com"
NODE_ENV="production"
PORT=3000
APP_NAME="Daxelo Kinrel"
API_PREFIX="api"

# ── Rate Limiting ─────────────────────────────────────────────
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=20
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=200

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS="https://kinrel.app,https://daxelokinrel.com"
