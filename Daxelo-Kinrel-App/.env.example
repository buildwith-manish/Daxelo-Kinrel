# ============================================================
# Daxelo KinRel App — Environment Variables Reference
# Copy this file as `.env` and fill in your actual values
# ============================================================
#
# ── How config actually reaches the app (QA hardening 2026-09-20) ──
#
# SUPABASE_URL and SUPABASE_ANON_KEY are ENV-ONLY with NO hardcoded
# fallback — the app throws a StateError at first use when they are
# missing (fail-loudly). Resolution order:
#
#   1. .env via flutter_dotenv — only if the file is BUNDLED as an
#      asset. Note: .env is gitignored and NOT listed in pubspec.yaml
#      assets, so this path is inactive for CI/release builds by design
#      (bundling it would ship credentials inside the app package).
#   2. --dart-define at compile time — THE mechanism for CI and
#      production. All build pipelines (GitHub Actions ci.yml /
#      deploy-web.yml / signed-release-apk.yml, Vercel vercel-build.sh)
#      inject these from secrets/env vars and fail the build when they
#      are absent.
#
# Local development:
#   flutter run \
#     --dart-define=SUPABASE_URL=https://<ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<publishable key>
#
# Non-secret public identifiers (API base URL, Google OAuth client IDs)
# keep sensible defaults in code — see lib/core/config/app_config.dart.
# ============================================================

# Supabase Configuration
# Find these in: Supabase Dashboard → Settings → API
# (use the publishable/anon key — NEVER a service_role key)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# API Base URL (NestJS Server)
API_BASE_URL=http://localhost:3001

# Google OAuth Client IDs
# Web client ID is from project 726935858050 (must match Supabase Google provider config)
# Android/iOS client IDs are from project 643588134212 (must match google-services.json)
# Supabase OAuth callback URL (add to Google Cloud Console authorized redirect URIs):
# https://promxswvsnvilplmrtsj.supabase.co/auth/v1/callback
GOOGLE_WEB_CLIENT_ID=726935858050-b0q96taocaa7rto463u466c49jdqkp41.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=643588134212-e74dp3uuh526ticm3c413b3gioefsenp.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=643588134212-ep2guf1q8fk5idsa224fu9e3t4bdu2e3.apps.googleusercontent.com
